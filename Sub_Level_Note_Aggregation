/*------------------------------------------------------------------------------------------------------------
THIS PATTERS AGGREGATES NOTES FOR A TOP HIERARCHY ITEM IF THEY ARE HELD INA  DIFFERENT TABLE AT A SUBID LEVEL

ORIGINALLY USED IN SSMS VERSION 16 AS LISTAGG WAS NOT AVAILABLE UNTIL SSMS VERSION 18
------------------------------------------------------------------------------------------------------------*/

DROP TABLE IF EXISTS #Raw
DROP TABLE IF EXISTS #FormatNotes
DROP TABLE IF EXISTS #GroupedNotes
DROP TABLE IF EXISTS #GroupedActivity


/*---------------------------------------------
Obtain Raw dataset that contains relevant data
---------------------------------------------*/
SELECT 
ID,
SubID,
DateTimeCreated,
DateTimeSubmitted,
DateTimeClosed,
IDStatus,
Creator,
TransactionID
INTO #Raw
FROM Source_Table
WHERE SubID like '[param]'
AND DateTimeCreated >= '[range]'


/*---------------------------------------------
Begin folding content rows into singular value
---------------------------------------------*/
SELECT
cn.ID,
ROW_NUMBER() OVER (	PARTITION BY cn.ID ORDER BY cn.NoteID ASC ) AS ID,
cn.NoteID,
cn.CreatedDateTime,
CASE WHEN MAX(cn.SubIDNumber) OVER (PARTITION BY cn.ID ORDER BY cn.NoteID ASC, cn.SubIDNumber) = '0' 
	 THEN MAX(cn.SubIDNumber) OVER (PARTITION BY cn.ID ORDER BY cn.NoteID DESC, cn.SubIDNumber)
	 ELSE MAX(cn.SubIDNumber) OVER (PARTITION BY cn.ID ORDER BY cn.NoteID ASC, cn.SubIDNumber) 
END as SubIDNumber,
CONCAT( FORMAT(cn.CreatedDateTime, 'yyyy-MM-dd HH:mm:ss'), ' - ', cn.Content, ' - [', cn.LastUpdatedBy, ']') as Content
INTO #FormatNotes
FROM #Raw r
LEFT JOIN NoteTable cn
	ON c.ID = cn.ID
ORDER BY cn.ID, cn.CreatedDateTime DESC


/*-----------------------------------------------
Iterate folding content rows into singular value
-----------------------------------------------*/
SELECT 
ID,
fn.SubIDNumber,
CAST(SubIDNumber as NVARCHAR(MAX)) + (CHAR(13) + CHAR(10))
+ STUFF(
	(	
    SELECT  
		CHAR(13) + CHAR(10) +  fn1.Content 			 
		FROM #FormatNotes fn1
		WHERE fn.ID = fn1.ID AND fn.SubIDNumber = fn1.SubIDNumber
		ORDER BY fn.ID asc, fn.SubIDNumber Desc
		FOR XML PATH (''), TYPE
  ).value('.','NVARCHAR(MAX)'),1,2,''
) AS GroupedNotes
INTO #GroupedNotes
FROM #FormatNotes fn
GROUP BY ID, SubIDNumber
ORDER BY ID, fn.SubIDNumber DESC


SELECT
gn.ID, 
STUFF(
	(	
    SELECT
		CHAR(10) + (CHAR(13) + CHAR(10)) + gn1.GroupedNotes
		FROM #GroupedNotes gn1
		WHERE gn.ID = gn1.ID
		ORDER BY gn.ID, CASE WHEN LEFT(GroupedNotes, 1) = '0' THEN '0' ELSE LEFT(GroupedNotes, 9) END Desc
		FOR XML PATH (''), TYPE
  ).value('.','NVARCHAR(MAX)'),1,3,''
) AS Content
INTO #GroupedActivity
FROM #GroupedNotes gn
GROUP BY gn.ID
ORDER BY gn.ID asc


SELECT 
ga.ID,
ga.Content
FROM #GroupedActivity ga
ORDER BY ga.ID
